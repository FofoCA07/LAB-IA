#!/usr/bin/env bash
set -euo pipefail

trap 'status=$?; printf "Error: lab-open falló en la línea %s (código %s).\n" "$LINENO" "$status" >&2; exit "$status"' ERR

usage() {
    printf 'Uso: %s <ruta-del-proyecto>\n' "${0##*/}" >&2
    printf 'Ejemplo: %s "/mnt/c/Users/usuario/Mi proyecto"\n' "${0##*/}" >&2
}

if [[ $# -gt 1 ]]; then
    usage
    exit 1
fi

if [[ $# -eq 1 ]]; then
    requested_workspace=$1
else
    selector_script_path=$(realpath -e -- "${BASH_SOURCE[0]}")
    selector_script_dir=$(dirname -- "$selector_script_path")
    selector_lab_root=$(cd -- "$selector_script_dir/.." && pwd -P)
    selector_history_file="$selector_lab_root/runtime/recent-workspaces"
    selectable_workspaces=()

    if [[ -f "$selector_history_file" ]]; then
        while IFS= read -r previous_workspace || [[ -n "$previous_workspace" ]]; do
            [[ -d "$previous_workspace" ]] || continue
            selectable_workspaces+=("$previous_workspace")
            [[ ${#selectable_workspaces[@]} -lt 10 ]] || break
        done < "$selector_history_file"
    fi

    requested_workspace=''
    if [[ ${#selectable_workspaces[@]} -gt 0 ]]; then
        printf 'Workspaces recientes:\n'
        for index in "${!selectable_workspaces[@]}"; do
            printf '%s) %s\n' "$((index + 1))" "${selectable_workspaces[index]}"
        done
        manual_option=$((${#selectable_workspaces[@]} + 1))
        printf '%s) Escribir otra ruta\n' "$manual_option"

        while true; do
            printf 'Selecciona una opción: '
            if ! IFS= read -r selection; then
                printf '\nError: no se pudo leer la selección.\n' >&2
                exit 1
            fi
            if [[ "$selection" == "$manual_option" ]]; then
                break
            fi
            for index in "${!selectable_workspaces[@]}"; do
                if [[ "$selection" == "$((index + 1))" ]]; then
                    requested_workspace=${selectable_workspaces[index]}
                    break
                fi
            done
            [[ -z "$requested_workspace" ]] || break
            printf 'Error: selecciona un número entre 1 y %s.\n' "$manual_option" >&2
        done
    fi

    if [[ -z "$requested_workspace" ]]; then
        printf 'Ruta del proyecto: '
        if ! IFS= read -r requested_workspace; then
            printf '\nError: no se pudo leer la ruta.\n' >&2
            exit 1
        fi
    fi
fi

workspace_path=$requested_workspace
if [[ "$workspace_path" =~ ^[a-zA-Z]: ]]; then
    if [[ "${workspace_path:2:1}" != '\' && "${workspace_path:2:1}" != '/' ]]; then
        printf 'Error: la ruta de Windows debe ser absoluta, por ejemplo C:\\Users\\usuario\\Proyecto.\n' >&2
        exit 1
    fi
    drive=${workspace_path:0:1}
    windows_path=${workspace_path:2}
    workspace_path="/mnt/${drive,,}${windows_path//\\//}"
elif [[ "$workspace_path" != /* && "$workspace_path" == *\\* ]]; then
    printf 'Error: las rutas relativas de Windows no están permitidas.\n' >&2
    exit 1
fi

if [[ ! -d "$workspace_path" ]]; then
    printf 'Error: la ruta no existe o no es un directorio: %s\n' "$requested_workspace" >&2
    exit 1
fi

workspace=$(cd -- "$workspace_path" && pwd -P)
script_path=$(realpath -e -- "${BASH_SOURCE[0]}")
script_dir=$(dirname -- "$script_path")
lab_root=$(cd -- "$script_dir/.." && pwd -P)
docker_dir="$lab_root/docker"

if [[ ! -f "$docker_dir/docker-compose.yml" ]]; then
    printf 'Error: no se encontró docker/docker-compose.yml junto al launcher de LAB-IA.\n' >&2
    exit 1
fi

if ! command -v docker >/dev/null 2>&1; then
    printf 'Error: Docker no está disponible en PATH.\n' >&2
    exit 1
fi

cd -- "$docker_dir"

compose() {
    LAB_WORKSPACE="$workspace" docker compose "$@"
}

printf 'Workspace solicitado: %s\n' "$requested_workspace"
printf 'Workspace resuelto: %s\n' "$workspace"

docker compose version
compose up -d --force-recreate opencode

container_id=$(compose ps -a -q opencode)
if [[ -z "$container_id" ]]; then
    printf 'Error: no se encontró el contenedor de OpenCode.\n' >&2
    exit 1
fi

state=$(docker inspect --format '{{.State.Status}}' "$container_id")
mounted_workspace=$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/workspace"}}{{.Source}}{{end}}{{end}}' "$container_id")

printf 'Workspace montado: %s\n' "${mounted_workspace:-no encontrado}"
printf 'Estado de OpenCode: %s\n' "$state"

if [[ "$state" != running ]]; then
    printf 'Error: el contenedor de OpenCode no está en ejecución.\n' >&2
    exit 1
fi

if [[ "$mounted_workspace" != "$workspace" ]]; then
    printf 'Error: el montaje de /workspace no coincide con el proyecto solicitado.\n' >&2
    exit 1
fi

printf 'Contenido de /workspace:\n'
compose exec -T opencode ls -la /workspace

runtime_dir="$lab_root/runtime"
history_file="$runtime_dir/recent-workspaces"
mkdir -p -- "$runtime_dir"

recent_workspaces=("$workspace")
if [[ -f "$history_file" ]]; then
    while IFS= read -r previous_workspace || [[ -n "$previous_workspace" ]]; do
        [[ -n "$previous_workspace" ]] || continue
        duplicate=false
        for recent_workspace in "${recent_workspaces[@]}"; do
            if [[ "$previous_workspace" == "$recent_workspace" ]]; then
                duplicate=true
                break
            fi
        done
        if [[ "$duplicate" == false ]]; then
            recent_workspaces+=("$previous_workspace")
        fi
        if [[ ${#recent_workspaces[@]} -ge 10 ]]; then
            break
        fi
    done < "$history_file"
fi

printf '%s\n' "${recent_workspaces[@]}" > "$history_file"
