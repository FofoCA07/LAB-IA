diff --git a/proyectos/lab-ia-web/server/maintenance/admission-gate.mjs b/proyectos/lab-ia-web/server/maintenance/admission-gate.mjs
new file mode 100644
index 0000000..d1d981b
--- /dev/null
+++ b/proyectos/lab-ia-web/server/maintenance/admission-gate.mjs
@@ -0,0 +1,24 @@
+// Thin candidate adapter. Reuses the existing state machine and lifecycle hooks.
+// No Docker, HTTP admin endpoint, default path, remote verifier or auto-reopening.
+import { createBackendHooks } from './backend-hooks.mjs';
+import { openLocalControl } from './local-control.mjs';
+
+export function createAdmissionGate({ barrier, json } = {}) {
+  if (!barrier || typeof json !== 'function'
+    || !['status', 'admit', 'drain', 'confirm', 'reopen', 'recover'].every(key => typeof barrier[key] === 'function')) {
+    throw new TypeError('EXISTING_BARRIER_REQUIRED');
+  }
+  const hooks = createBackendHooks(barrier, json);
+  return Object.freeze({
+    hooks,
+    status() {
+      return { ...barrier.status(), scope: 'BACKEND_TRACKED_OPERATIONS_ONLY',
+        remoteExclusivity: 'NOT_VERIFIED' };
+    },
+    openControl({ directory, authorize = () => false } = {}) {
+      // The caller supplies an explicitly private directory. No diagnostics or
+      // force-clear/reconcile command is added to the existing control protocol.
+      return openLocalControl({ directory, barrier, authorize });
+    },
+  });
+}
diff --git a/proyectos/lab-ia-web/server/maintenance/backend-hooks.mjs b/proyectos/lab-ia-web/server/maintenance/backend-hooks.mjs
new file mode 100644
index 0000000..f4be817
--- /dev/null
+++ b/proyectos/lab-ia-web/server/maintenance/backend-hooks.mjs
@@ -0,0 +1,117 @@
+// Candidate integration hooks. No Docker client, network destination or credentials.
+import { AsyncLocalStorage } from 'node:async_hooks';
+import { failure } from './barrier.mjs';
+
+export function createBackendHooks(barrier, json) {
+  const context = new AsyncLocalStorage();
+  function current() {
+    const job = context.getStore(); if (!job) throw failure('MISSING_ADMISSION'); return job;
+  }
+  async function own(job, callback) {
+    return context.run(job, async () => {
+      try { return await callback(); }
+      finally { job.finish(); }
+    });
+  }
+  function run(kind, callback) { return own(barrier.admit(kind), callback); }
+  async function dispatch(kind, request, response, callback) {
+    let job;
+    try { job = barrier.admit(kind); }
+    catch (error) {
+      if (!['ADMISSION_CLOSED', 'PERSISTENCE_FAILED', 'DISPOSED', 'CAPACITY'].includes(error.code)) throw error;
+      if (!response.destroyed && !response.headersSent) {
+        response.setHeader('Cache-Control', 'no-store');
+        json(response, 503, { success: false, code: 'MAINTENANCE', error: 'Servicio temporalmente no disponible.' });
+      }
+      return;
+    }
+    return own(job, callback); // Never free tickets on request/response close.
+  }
+  function track(callback, type = 'promise') {
+    const job = current(); const hold = job.hold(type);
+    return Promise.resolve().then(callback).finally(() => hold.finish());
+  }
+  function defer(callback, schedule) {
+    const job = current(); const hold = job.hold('deferred');
+    try {
+      schedule(() => {
+        void context.run(job, async () => {
+          try { await callback(); }
+          catch { job.mark('OPERATION_FAILED'); }
+          finally { hold.finish(); }
+        }).catch(() => { /* Persistence fault remains observable and closed. */ });
+      });
+    } catch (error) { hold.finish(); throw error; }
+  }
+  function admitWarmup() {
+    const job = barrier.admit('warmup'); // Own shared job; admission precedes scheduling/fetch.
+    return Object.freeze({ run: callback => own(job, () => Promise.resolve().then(callback)) });
+  }
+  function child(start, { remote = false, verifyRemote, events = () => {} } = {}) {
+    const job = current(); const reservation = job.hold('process');
+    let process; let tracking;
+    const emit = type => { try { events(type); } catch { /* Metadata observer only. */ } };
+    try {
+      process = start(); tracking = job.trackChild(process, { remote, verifyRemote });
+    } catch (error) { job.mark('PROCESS_ERROR'); reservation.finish(); throw error; }
+    reservation.finish(); emit('start');
+    const done = new Promise(resolve => {
+      process.once('exit', () => emit('exit'));
+      process.once('close', (code, signal) => { emit('close'); resolve({ code, signal }); });
+    });
+    function interrupt(code, signal) {
+      job.mark(code); emit(code === 'TIMEOUT' ? 'timeout' : 'cancel');
+      if (!process.kill(signal)) return false;
+      return true; // Successful signal delivery is NOT completion evidence.
+    }
+    return Object.freeze({ process, done, tracking,
+      timeout: () => interrupt('TIMEOUT', 'SIGTERM'), cancel: () => interrupt('UNCERTAIN', 'SIGTERM') });
+  }
+  function trackedFetch(fetchImpl) {
+    if (typeof fetchImpl !== 'function') throw failure('FETCH_REQUIRED');
+    return async (...args) => {
+      const job = current(); const hold = job.hold('remote'); let settled = false;
+      const signal = args[1]?.signal;
+      const interrupted = () => { if (!settled) { try { job.mark('UNCERTAIN'); } catch { /* Remains closed. */ } } };
+      const release = () => { if (!settled) { settled = true; signal?.removeEventListener('abort', interrupted); hold.finish(); } };
+      const uncertain = () => { if (settled) return; try { job.mark('UNCERTAIN'); } finally { release(); } };
+      try {
+        signal?.addEventListener('abort', interrupted, { once: true });
+        if (signal?.aborted) throw failure('FETCH_ABORTED');
+        const response = await fetchImpl(...args);
+        if (!response.body) { uncertain(); return response; }
+        const body = response.body;
+        const wrapped = {
+          getReader(...options) {
+            const reader = body.getReader(...options);
+            // A cancelled reader also resolves closed: only read().done is EOF.
+            void reader.closed.catch(uncertain).catch(() => {});
+            return new Proxy(reader, { get(target, key) {
+              if (key === 'read') return async (...readArgs) => {
+                try { const value = await target.read(...readArgs); if (value.done) release(); return value; }
+                catch (error) { uncertain(); throw error; }
+              };
+              if (key === 'cancel') return (...cancelArgs) => { uncertain(); return target.cancel(...cancelArgs); };
+              const value = Reflect.get(target, key, target);
+              return typeof value === 'function' ? value.bind(target) : value;
+            } });
+          },
+          cancel(...options) {
+            return body.cancel(...options).then(uncertain, uncertain);
+          },
+          get locked() { return body.locked; },
+        };
+        return new Proxy(response, { get(target, key) {
+          if (key === 'body') return wrapped;
+          const value = Reflect.get(target, key, target);
+          return typeof value === 'function' ? value.bind(target) : value;
+        } });
+      } catch (error) { uncertain(); throw error; }
+    };
+  }
+  function statusProbe(withCLI, inspectOnly) {
+    if (barrier.status().state !== 'NORMAL' || barrier.status().recoveryRequired) return inspectOnly();
+    return run('probe', withCLI);
+  }
+  return Object.freeze({ run, dispatch, track, defer, admitWarmup, child, trackedFetch, statusProbe });
+}
diff --git a/proyectos/lab-ia-web/server/maintenance/barrier.mjs b/proyectos/lab-ia-web/server/maintenance/barrier.mjs
new file mode 100644
index 0000000..4017659
--- /dev/null
+++ b/proyectos/lab-ia-web/server/maintenance/barrier.mjs
@@ -0,0 +1,182 @@
+// Candidate only. Trusted backend hooks supply lifecycle evidence, never HTTP input.
+import { EventEmitter } from 'node:events';
+
+export const KINDS = Object.freeze(['summary', 'activation', 'chat', 'continuation',
+  'proposal', 'apply', 'action', 'write', 'warmup', 'probe',
+  'admin-health', 'admin-reviewer', 'admin-summary', 'admin-workspace']);
+const RESOURCES = new Set(['process', 'remote', 'deferred', 'promise']);
+const CODES = new Set(['TIMEOUT', 'PROCESS_ERROR', 'OPERATION_FAILED', 'UNCERTAIN']);
+export function failure(code) { return Object.assign(new Error(code), { code }); }
+
+export function createBarrier({ store, verifyRecovery = async () => false,
+  verifyUncertain = async () => false } = {}) {
+  if (!store?.load || !store?.save) throw failure('STORE_REQUIRED');
+  const events = new EventEmitter();
+  const jobs = new Map();
+  let sequence = 0;
+  let state = 'DRAINING';
+  let recoveryRequired = true;
+  let fault = null;
+  let lastError = null;
+  let disposed = false;
+  let recoveryRunning = false;
+  const recovered = store.load(); // Corruption must abort initialization, not reset state.
+  if (recovered !== null) {
+    if (recovered.version !== 1 || !['NORMAL', 'DRAINING', 'MAINTENANCE'].includes(recovered.state)
+      || !Number.isSafeInteger(recovered.sequence) || recovered.sequence < 0
+      || !Array.isArray(recovered.jobs) || recovered.jobs.length > 256) throw failure('INVALID_STATE');
+    sequence = recovered.sequence;
+    for (const item of recovered.jobs) {
+      if (!/^j[1-9][0-9]*$/.test(item.id) || !KINDS.includes(item.kind)
+        || jobs.has(item.id) || Number(item.id.slice(1)) > sequence) throw failure('INVALID_STATE');
+      jobs.set(item.id, { id: item.id, kind: item.kind, recovered: true,
+        rootDone: false, uncertain: true, resources: new Map() });
+    }
+    // Every boot starts DRAINING, including a previous MAINTENANCE checkpoint.
+    // Historical state never substitutes for fresh termination evidence.
+  }
+  function status() {
+    return { state, recoveryRequired, fault, lastError, active: jobs.size,
+      jobs: [...jobs.values()].map(j => ({ id: j.id, kind: j.kind,
+        rootDone: j.rootDone, uncertain: j.uncertain, recovered: j.recovered,
+        resources: [...j.resources.values()] })) };
+  }
+  function save() {
+    try {
+      store.save({ version: 1, state, sequence,
+        jobs: [...jobs.values()].map(({ id, kind }) => ({ id, kind })) });
+    } catch {
+      state = 'DRAINING'; fault = 'PERSISTENCE_FAILED';
+      events.emit('change'); throw failure(fault);
+    }
+    events.emit('change');
+  }
+  function usable() { if (disposed || fault) throw failure(fault ?? 'DISPOSED'); }
+  function ready() { usable(); if (recoveryRequired || jobs.size) throw failure('NOT_DRAINED'); }
+  function drain() { usable(); state = 'DRAINING'; save(); return status(); }
+  function confirm() {
+    ready(); if (state !== 'DRAINING') throw failure('BAD_STATE');
+    state = 'MAINTENANCE'; save(); return status();
+  }
+  function reopen() {
+    ready(); if (state !== 'MAINTENANCE') throw failure('BAD_STATE');
+    state = 'NORMAL'; save(); return status();
+  }
+  function ticket(kind, administrative = false) {
+    usable();
+    if (!KINDS.includes(kind) || kind.startsWith('admin-') !== administrative) throw failure('INVALID_KIND');
+    if (recoveryRequired || (administrative ? state !== 'MAINTENANCE' || jobs.size : state !== 'NORMAL')) {
+      throw failure('ADMISSION_CLOSED');
+    }
+    if (jobs.size >= 256 || sequence >= Number.MAX_SAFE_INTEGER) throw failure('CAPACITY');
+    if (administrative) state = 'DRAINING'; // Never report maintenance while a diagnostic is active.
+    const j = { id: `j${++sequence}`, kind, recovered: false, rootDone: false,
+      uncertain: false, resources: new Map() };
+    jobs.set(j.id, j);
+    save(); // Durable registration before the caller can start work. No await in admission.
+    let resourceSequence = 0;
+    function settle() {
+      if (j.rootDone && !j.resources.size && !j.uncertain) jobs.delete(j.id);
+      save();
+    }
+    function mark(code) {
+      usable(); if (!CODES.has(code)) throw failure('INVALID_CODE');
+      if (!jobs.has(j.id)) throw failure('JOB_FINISHED');
+      lastError = code;
+      if (code !== 'OPERATION_FAILED') { j.uncertain = true; state = 'DRAINING'; }
+      save();
+    }
+    function hold(type) {
+      usable();
+      // A previously reserved deferred operation can acquire its own resources
+      // after HTTP/root completion. It cannot resurrect a finished job.
+      if (!RESOURCES.has(type) || !jobs.has(j.id)
+        || (j.rootDone && !j.resources.size)) throw failure('INVALID_RESOURCE');
+      const id = ++resourceSequence; j.resources.set(id, type); save();
+      let finished = false;
+      return Object.freeze({ finish() {
+        if (finished) return false;
+        usable(); finished = true; j.resources.delete(id); settle(); return true;
+      } });
+    }
+    return Object.freeze({ id: j.id, hold, mark,
+      finish() {
+        if (j.rootDone) return false;
+        usable(); j.rootDone = true; settle(); return true;
+      },
+      // Call immediately after spawn, before returning to the event loop.
+      // A Docker/shell client requires a remote verifier as well as local close.
+      trackChild(child, { remote = false, verifyRemote = async () => false } = {}) {
+        const process = hold('process');
+        const upstream = remote ? hold('remote') : null;
+        let closed = false;
+        async function verifyRemoteCompletion() {
+          if (!remote || !closed) throw failure('REMOTE_NOT_CLOSED');
+          try {
+            if (await verifyRemote() !== true) { mark('UNCERTAIN'); return false; }
+            upstream.finish(); return true;
+          } catch { try { mark('UNCERTAIN'); } catch { /* Fault remains closed. */ } return false; }
+        }
+        child.once('error', () => { try { mark('PROCESS_ERROR'); } catch { /* Fault remains closed. */ } });
+        child.once('close', () => {
+          closed = true;
+          try { process.finish(); } catch { return; }
+          if (remote) void verifyRemoteCompletion();
+        });
+        return Object.freeze({ verifyRemoteCompletion });
+      },
+    });
+  }
+  async function recover() {
+    usable();
+    if (!recoveryRequired || recoveryRunning) throw failure('BAD_STATE');
+    recoveryRunning = true;
+    try {
+      if (await verifyRecovery(status()) !== true) throw failure('RECOVERY_REQUIRED');
+      usable();
+      if ([...jobs.values()].some(j => !j.recovered)) throw failure('NOT_DRAINED');
+      jobs.clear(); recoveryRequired = false; save(); return status();
+    } catch (error) {
+      lastError = error.code === 'PERSISTENCE_FAILED' ? error.code : 'RECOVERY_REQUIRED';
+      throw failure(lastError);
+    } finally { recoveryRunning = false; }
+  }
+  async function reconcileJob(id) {
+    usable(); const j = jobs.get(id);
+    if (!j || j.recovered || !j.rootDone || j.resources.size || !j.uncertain) throw failure('NOT_RECONCILABLE');
+    if (await verifyUncertain({ id: j.id, kind: j.kind }) !== true) throw failure('UNCERTAIN');
+    usable(); if (jobs.get(id) !== j) throw failure('JOB_CHANGED');
+    j.uncertain = false; jobs.delete(id); save(); return status();
+  }
+  function waitForDrain({ timeoutMs = 1000, signal } = {}) {
+    if (!Number.isInteger(timeoutMs) || timeoutMs < 1 || timeoutMs > 120000) return Promise.reject(failure('INVALID_TIMEOUT'));
+    return new Promise((resolve, reject) => {
+      let timer;
+      const cleanup = () => { clearTimeout(timer); events.off('change', check); signal?.removeEventListener('abort', abort); };
+      const abort = () => { cleanup(); reject(failure('WAIT_ABORTED')); };
+      const check = () => {
+        if (fault || disposed) { cleanup(); reject(failure(fault ?? 'DISPOSED')); }
+        else if (state !== 'NORMAL' && !jobs.size && !recoveryRequired) { cleanup(); resolve(status()); }
+      };
+      timer = setTimeout(() => { cleanup(); reject(failure('WAIT_TIMEOUT')); }, timeoutMs);
+      events.on('change', check); signal?.addEventListener('abort', abort, { once: true });
+      if (signal?.aborted) abort(); else check();
+    });
+  }
+  async function runAdministrative(kind, callback) {
+    const job = ticket(kind, true);
+    try { await callback(job); }
+    catch { job.mark('OPERATION_FAILED'); throw failure('DIAGNOSTIC_FAILED'); }
+    finally { job.finish(); }
+    return status(); // Caller must confirm again; unfinished resources remain visible.
+  }
+  save();
+  return Object.freeze({ status, drain, confirm, reopen, recover, reconcileJob, waitForDrain,
+    admit: kind => ticket(kind), runAdministrative,
+    close() {
+      if (disposed) return;
+      try { if (!fault) { state = 'DRAINING'; save(); } }
+      finally { disposed = true; events.emit('change'); store.close?.(); }
+    },
+  });
+}
diff --git a/proyectos/lab-ia-web/server/maintenance/private-store.mjs b/proyectos/lab-ia-web/server/maintenance/private-store.mjs
new file mode 100644
index 0000000..8cc9578
--- /dev/null
+++ b/proyectos/lab-ia-web/server/maintenance/private-store.mjs
@@ -0,0 +1,61 @@
+// No default production path. Only a dedicated, explicitly supplied private directory.
+import fs from 'node:fs';
+import path from 'node:path';
+import { randomUUID } from 'node:crypto';
+import { failure } from './barrier.mjs';
+
+export function assertPrivateDirectory(directory) {
+  if (!path.isAbsolute(directory) || path.resolve(directory) !== directory
+    || fs.realpathSync(directory) !== directory) throw failure('UNSAFE_DIRECTORY');
+  const s = fs.lstatSync(directory);
+  if (!s.isDirectory() || s.uid !== process.getuid() || (s.mode & 0o777) !== 0o700) throw failure('UNSAFE_DIRECTORY');
+}
+function privateFile(file) {
+  const s = fs.lstatSync(file);
+  if (!s.isFile() || s.isSymbolicLink() || s.nlink !== 1 || s.uid !== process.getuid()
+    || (s.mode & 0o777) !== 0o600 || s.size > 65536) throw failure('UNSAFE_STATE');
+}
+export function openPrivateStore(directory) {
+  assertPrivateDirectory(directory);
+  const state = path.join(directory, 'state.json');
+  const lock = path.join(directory, 'owner.lock');
+  const lockFD = fs.openSync(lock, 'wx', 0o600); // Never automatically remove a stale/live owner lock.
+  fs.writeFileSync(lockFD, String(process.pid)); fs.fsyncSync(lockFD);
+  let closed = false;
+  const ownLock = fs.fstatSync(lockFD);
+  const check = () => {
+    if (closed) throw failure('STORE_CLOSED');
+    assertPrivateDirectory(directory);
+    const current = fs.lstatSync(lock);
+    if (current.ino !== ownLock.ino || current.dev !== ownLock.dev) throw failure('OWNER_CHANGED');
+  };
+  return Object.freeze({
+    load() {
+      check();
+      try { privateFile(state); } catch (error) { if (error.code === 'ENOENT') return null; throw error; }
+      return JSON.parse(fs.readFileSync(state, 'utf8'));
+    },
+    save(value) {
+      check();
+      try { privateFile(state); } catch (error) { if (error.code !== 'ENOENT') throw error; }
+      const temporary = path.join(directory, `.state-${randomUUID()}`);
+      const fd = fs.openSync(temporary, 'wx', 0o600);
+      try {
+        const data = JSON.stringify(value) + '\n';
+        if (Buffer.byteLength(data) > 65536) throw failure('STATE_TOO_LARGE');
+        fs.writeFileSync(fd, data); fs.fsyncSync(fd);
+        fs.renameSync(temporary, state);
+        const dirFD = fs.openSync(directory, 'r');
+        try { fs.fsyncSync(dirFD); } finally { fs.closeSync(dirFD); }
+      } finally {
+        fs.closeSync(fd);
+        if (fs.existsSync(temporary)) fs.unlinkSync(temporary);
+      }
+    },
+    close() {
+      if (closed) return;
+      try { check(); fs.unlinkSync(lock); }
+      finally { closed = true; fs.closeSync(lockFD); }
+    },
+  });
+}
diff --git a/proyectos/lab-ia-web/server/maintenance/local-control.mjs b/proyectos/lab-ia-web/server/maintenance/local-control.mjs
new file mode 100644
index 0000000..261fd8d
--- /dev/null
+++ b/proyectos/lab-ia-web/server/maintenance/local-control.mjs
@@ -0,0 +1,77 @@
+// Candidate JSON-lines control; no TCP listener, shell, Docker or public HTTP API.
+import net from 'node:net';
+import fs from 'node:fs';
+import path from 'node:path';
+import { assertPrivateDirectory } from './private-store.mjs';
+import { failure } from './barrier.mjs';
+
+export async function openLocalControl({ directory, barrier, authorize = () => false,
+  diagnostics = {} }) {
+  const socketPath = path.join(directory, 'control.sock');
+  const closeAdmission = () => { try { barrier.drain(); } catch { /* Already fail-closed. */ } };
+  try {
+    assertPrivateDirectory(directory);
+    if (Buffer.byteLength(socketPath) > 100) throw failure('UNSAFE_SOCKET');
+    try { fs.lstatSync(socketPath); throw failure('UNSAFE_SOCKET'); }
+    catch (error) { if (error.code !== 'ENOENT') throw error; }
+  } catch (error) { closeAdmission(); throw error; }
+  const sockets = new Set();
+  const server = net.createServer(socket => {
+    if (sockets.size >= 4) { socket.destroy(); return; }
+    sockets.add(socket); socket.once('close', () => sockets.delete(socket));
+    socket.setTimeout(2000, () => socket.destroy());
+    socket.on('error', () => {});
+    let data = Buffer.alloc(0); let used = false;
+    socket.on('data', chunk => {
+      if (used) { socket.destroy(); return; }
+      data = Buffer.concat([data, chunk]);
+      if (data.length > 1024) { socket.destroy(); return; }
+      const newline = data.indexOf(10);
+      if (newline < 0) return;
+      used = true;
+      void (async () => {
+        try {
+          const request = JSON.parse(data.toString('utf8'));
+          if (!request || Array.isArray(request) || Object.keys(request).some(k => !['command', 'kind'].includes(k))
+            || !['status', 'drain', 'confirm', 'reopen', 'recover', 'diagnostic'].includes(request.command)
+            || (request.command !== 'diagnostic' && 'kind' in request)) throw failure('INVALID_COMMAND');
+          if (await authorize(request.command) !== true) throw failure('UNAUTHORIZED');
+          let result;
+          if (request.command === 'diagnostic') {
+            if (!['admin-health', 'admin-reviewer', 'admin-summary', 'admin-workspace'].includes(request.kind)
+              || !Object.hasOwn(diagnostics, request.kind) || typeof diagnostics[request.kind] !== 'function') throw failure('DIAGNOSTIC_UNAVAILABLE');
+            result = await barrier.runAdministrative(request.kind, diagnostics[request.kind]);
+          } else result = await barrier[request.command]();
+          socket.end(JSON.stringify({ ok: true, status: result }) + '\n');
+        } catch (error) {
+          const allowed = ['UNAUTHORIZED', 'INVALID_COMMAND', 'ADMISSION_CLOSED', 'NOT_DRAINED',
+            'BAD_STATE', 'RECOVERY_REQUIRED', 'DIAGNOSTIC_UNAVAILABLE', 'DIAGNOSTIC_FAILED', 'PERSISTENCE_FAILED'];
+          socket.end(JSON.stringify({ ok: false, code: allowed.includes(error.code) ? error.code : 'CONTROL_FAILED' }) + '\n');
+        }
+      })();
+    });
+  });
+  // Private 0700 directory already restricts access during the bind/chmod interval.
+  try {
+    await new Promise((resolve, reject) => {
+      server.once('error', reject); server.listen(socketPath, resolve);
+    });
+    fs.chmodSync(socketPath, 0o600);
+  } catch (error) {
+    closeAdmission();
+    if (server.listening) await new Promise(resolve => server.close(resolve));
+    throw error;
+  }
+  const identity = fs.lstatSync(socketPath);
+  server.on('error', () => { try { barrier.drain(); } catch { /* Already fail-closed. */ } });
+  server.once('close', () => { try { barrier.drain(); } catch { /* Already fail-closed. */ } });
+  return Object.freeze({ socketPath, async close() {
+    for (const socket of sockets) socket.destroy();
+    await new Promise((resolve, reject) => server.close(error => error ? reject(error) : resolve()));
+    // Node may remove its own socket on close. Never delete a substituted resource.
+    try {
+      const current = fs.lstatSync(socketPath);
+      if (current.ino === identity.ino && current.dev === identity.dev && current.isSocket()) fs.unlinkSync(socketPath);
+    } catch (error) { if (error.code !== 'ENOENT') throw error; }
+  } });
+}
diff --git a/proyectos/lab-ia-web/server/maintenance/runtime.mjs b/proyectos/lab-ia-web/server/maintenance/runtime.mjs
new file mode 100644
index 0000000..11473c2
--- /dev/null
+++ b/proyectos/lab-ia-web/server/maintenance/runtime.mjs
@@ -0,0 +1,24 @@
+// Candidate bootstrap. Closed on every boot; no auto-recover/reopen.
+import { createBarrier } from './barrier.mjs';
+import { openPrivateStore } from './private-store.mjs';
+import { createAdmissionGate } from './admission-gate.mjs';
+export async function openAdmissionRuntime({ directory, json, operatorEnabled = false }) {
+  let store; let barrier; let control; let closing;
+  try {
+    store = openPrivateStore(directory); // Must already exist privately; never create/overwrite.
+    barrier = createBarrier({ store,
+      verifyRecovery: async status => status.jobs.length === 0 });
+    const gate = createAdmissionGate({ barrier, json });
+    control = await gate.openControl({ directory,
+      authorize: command => operatorEnabled === true && ['status', 'drain', 'confirm', 'recover', 'reopen'].includes(command) });
+    return Object.freeze({ hooks: gate.hooks, status: gate.status, barrier, control,
+      close() {
+        return closing ??= (async () => {
+          try { await control.close(); } finally { barrier.close(); }
+        })();
+      } });
+  } catch {
+    try { if (barrier) barrier.close(); else store?.close(); } catch { /* Preserve state/fault. */ }
+    throw Object.assign(new Error('MAINTENANCE_STARTUP_FAILED'), { code: 'MAINTENANCE_STARTUP_FAILED' });
+  }
+}
